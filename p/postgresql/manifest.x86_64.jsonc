				"pkgconfig(openssl)",
				"pkgconfig(pam)",
				"pkgconfig(readline)",
				"pkgconfig(uuid)",
				"pkgconfig(zlib)"
			],
			"depends": [
				"postgresql",
				"soname(libLLVM.so.23.1(x86_64))",
				"soname(libc.so.6(x86_64))",
				"soname(libstdc++.so.6(x86_64))"
			],
			"files": [
				"/usr/lib/postgresql/llvmjit.so",
				"/usr/lib/postgresql/llvmjit_types.bc"
			],
			"name": "postgresql-jit",
			"provides": [
				"soname(postgresql/llvmjit.so(x86_64))"
			]
		}
	},
