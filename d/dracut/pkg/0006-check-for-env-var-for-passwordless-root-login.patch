Description: systemd dracut-emergency.service override Environment=SYSTEMD_SULOGIN_FORCE=1 compat
 This enables users to use rd.shell or rd.break to drop to an unlocked initramfs rescue shell
 if the above is set. This is an additive change, so existing documentation still applies.
Forwarded: not-needed
Origin: vendor
Author: Rune Morling <ermo@aerynos.com>

diff --git a/modules.d/77dracut-systemd/dracut-emergency.sh b/modules.d/77dracut-systemd/dracut-emergency.sh
index a427a8f..a4000be 100755
--- a/modules.d/77dracut-systemd/dracut-emergency.sh
+++ b/modules.d/77dracut-systemd/dracut-emergency.sh
@@ -34,7 +34,7 @@ if getargbool 1 rd.shell || getarg rd.break; then
     [ -z "$PS1" ] && PS1="$_rdshell_name:\${PWD}# "
     export PS1

-    if getargbool 0 SYSTEMD_SULOGIN_FORCE; then
+    if getargbool 0 SYSTEMD_SULOGIN_FORCE || [ -n "$SYSTEMD_SULOGIN_FORCE" ]; then
         # allows passwordless logins if root account is locked.
         exec sulogin -e
     else
