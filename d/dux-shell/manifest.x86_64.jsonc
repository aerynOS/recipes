/** Human readable report. This is not consumed by boulder */
{
	"manifest-version": "0.2",
	"packages": {
		"dux-shell": {
			"build-depends": [
				"binary(tar)"
			],
			"depends": [
				"accountsservice",
				"binary(quickshell)",
				"ca-certificates",
				"dux-gop",
