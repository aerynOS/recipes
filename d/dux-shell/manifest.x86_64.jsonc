				"/usr/share/icons/hicolor/scalable/apps/dev.duxlabs.shell.svg",
				"/usr/share/zsh/site-functions/_dms"
			],
			"name": "dux-shell",
			"provides": [
				"binary(dms)"
			]
		}
	},
	"source-name": "dux-shell",
