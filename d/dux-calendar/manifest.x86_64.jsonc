/** Human readable report. This is not consumed by boulder */
{
	"manifest-version": "0.2",
	"packages": {
		"dux-calendar": {
			"build-depends": [
				"binary(go)",
				"binary(tar)"
			],
			"depends": [
				"binary(quickshell)",
				"ca-certificates",
				"interpreter(/usr/lib/ld-linux-x86-64.so.2(x86_64))",
				"soname(libc.so.6(x86_64))"
			],
			"files": [
				"/usr/bin/dcal",
				"/usr/lib/systemd/user/dcal.service",
				"/usr/share/applications/dev.duxlabs.calendar.desktop",
				"/usr/share/bash-completion/completions/dcal",
				"/usr/share/fish/vendor_completions.d/dcal.fish",
				"/usr/share/icons/hicolor/scalable/apps/dev.duxlabs.calendar.svg",
				"/usr/share/metainfo/dev.duxlabs.calendar.metainfo.xml",
				"/usr/share/zsh/site-functions/_dcal"
			],
			"name": "dux-calendar",
			"provides": [
				"binary(dcal)"
			]
		}
	},
	"source-name": "dux-calendar",
	"source-release": "2",
	"source-version": "2.1.0"
}
