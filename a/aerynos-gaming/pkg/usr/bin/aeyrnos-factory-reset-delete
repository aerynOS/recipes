set -e
set -u

# deletion seems to work for now
rm -Rf /home/gamer
mkdir -p /home/gamer
cp -r /etc/skel/. /home/gamer
chown -R gamer:gamer /home/gamer
sleep 2
systemctl disable aerynos-factory-reset
