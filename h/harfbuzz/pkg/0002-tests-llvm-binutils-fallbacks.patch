From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Reilly Brogan <reilly@reillybrogan.com>
Date: Fri, 6 Nov 2026 11:17:53 -0600
Subject: [PATCH] [tests] Fall back to llvm-objdump and llvm-nm

Toolchains that ship only the LLVM binutils have no GNU objdump or nm, so
check-static-inits and check-symbols are skipped. Try llvm-objdump and
llvm-nm as fallbacks; their output is compatible with the parsing in these
checks. Also correct the check-static-inits skip message, which named ldd
instead of objdump.

Origin: vendor
Forwarded: https://github.com/ReillyBrogan/harfbuzz/tree/llvm-binutils
Last-Update: 2026-11-06
---
 src/check-static-inits.py | 4 ++--
 src/check-symbols.py      | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/check-static-inits.py b/src/check-static-inits.py
index 44d01797f..4b51b75c5 100755
--- a/src/check-static-inits.py
+++ b/src/check-static-inits.py
@@ -11,9 +11,9 @@ srcdir = sys.argv[1]
 base_srcdir = sys.argv[2]
 builddir = sys.argv[3]
 
-objdump = os.getenv("OBJDUMP", shutil.which("objdump"))
+objdump = os.getenv("OBJDUMP") or shutil.which("objdump") or shutil.which("llvm-objdump")
 if not objdump:
-    print("check-static-inits.py: 'ldd' not found; skipping test")
+    print("check-static-inits.py: 'objdump' not found; skipping test")
     sys.exit(77)
 
 if sys.version_info < (3, 5):
diff --git a/src/check-symbols.py b/src/check-symbols.py
index f4b17c5e6..c9d051b84 100755
--- a/src/check-symbols.py
+++ b/src/check-symbols.py
@@ -50,7 +50,7 @@ IGNORED_SYMBOLS += [
 
 IGNORED_SYMBOLS = "|".join(IGNORED_SYMBOLS)
 
-nm = os.getenv("NM", shutil.which("nm"))
+nm = os.getenv("NM") or shutil.which("nm") or shutil.which("llvm-nm")
 if not nm:
     print("check-symbols.py: 'nm' not found; skipping test")
     sys.exit(77)
