				"soname(libc.so.6(x86_64))",
				"soname(libcrypto.so.4(x86_64))",
				"soname(libssl.so.4(x86_64))",
				"sysbinary(pppd)"
			],
			"files": [
				"/usr/bin/openfortivpn",
				"/usr/share/defaults/openfortivpn/config",
				"/usr/share/man/man1/openfortivpn.1",
				"/usr/share/openfortivpn/config.template"
			],
			"name": "openfortivpn",
			"provides": [
				"binary(openfortivpn)"
			]
		}
	},
	"source-name": "openfortivpn",
	"source-release": "1",
	"source-version": "1.24.1"
