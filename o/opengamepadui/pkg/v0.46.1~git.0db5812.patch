From bdbcbca3715356454819497d85838ea92c4e930e Mon Sep 17 00:00:00 2001
From: William Edwards <shadowapex@gmail.com>
Date: Thu, 1 Oct 2026 18:09:12 -0700
Subject: [PATCH 01/10] chore(CI): use manual dispatch for releases instead of
 on merge to main

---
 .github/workflows/release.yaml | 11 ++---------
 1 file changed, 2 insertions(+), 9 deletions(-)

diff --git a/.github/workflows/release.yaml b/.github/workflows/release.yaml
index 60199514e..64c9382a6 100644
--- a/.github/workflows/release.yaml
+++ b/.github/workflows/release.yaml
@@ -1,16 +1,9 @@
 # Build and publish a release of OpenGamepadUI using semantic-release whenever
-# changes are merged into main.
+# this job is run manually.
 name: "🎉 Release"
 
 on:
-  push:
-    branches:
-      - main
-      - v0.x
-      - v1.x
-    paths-ignore:
-      - README.md
-      - "docs/**"
+  workflow_dispatch:
 
 env:
   IMAGE_NAME: ghcr.io/shadowblip/opengamepadui-builder

