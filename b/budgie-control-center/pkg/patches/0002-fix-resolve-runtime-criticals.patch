-                <signal name="clicked" handler="webcam_icon_selected" swapped="yes"/>
-              </object>
-            </child>
             <child>
               <object class="GtkButton">
                 <property name="visible">True</property>
diff --git a/shell/cc-application.c b/shell/cc-application.c
index 9a909c4375..833359f731 100644
--- a/shell/cc-application.c
+++ b/shell/cc-application.c
@@ -222,6 +222,7 @@ cc_application_startup (GApplication *application)
 {
   CcApplication *self = CC_APPLICATION (application);
   const gchar *help_accels[] = { "F1", NULL };
+  g_autoptr(GtkCssProvider) provider = NULL;
 
   g_action_map_add_action_entries (G_ACTION_MAP (self),
                                    cc_app_actions,
@@ -230,6 +231,12 @@ cc_application_startup (GApplication *application)
 
   G_APPLICATION_CLASS (cc_application_parent_class)->startup (application);
 
+  provider = gtk_css_provider_new ();
+  gtk_css_provider_load_from_resource (provider, "/org/buddiesofbudgie/ControlCenter/gtk/style.css");
