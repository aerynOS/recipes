From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Reilly Brogan <reilly@reillybrogan.com>
Date: Fri, 13 Nov 2026 14:00:00 -0600
Subject: [PATCH] Fix k5tls build against OpenSSL 4.0

OpenSSL 4.0 constifies the pointers returned by X509_get_ext() and
X509_get_subject_name(). The k5tls helpers store them in non-const locals,
which fails with -Werror=incompatible-pointer-types-discards-qualifiers.
Use const locals and add cast macros for the functions that still take
non-const pointers.

Origin: vendor
Forwarded: not-needed
Last-Update: 2026-11-13
---
 src/plugins/tls/k5tls/openssl.c | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/src/plugins/tls/k5tls/openssl.c b/src/plugins/tls/k5tls/openssl.c
--- a/src/plugins/tls/k5tls/openssl.c
+++ b/src/plugins/tls/k5tls/openssl.c
@@ -54,6 +54,11 @@
  */
 #define X509_check_host(a, b, c, d, e) X509_check_host((X509 *)a, b, c, d, e)
 #define X509_check_ip_asc(a, b, c) X509_check_ip_asc((X509 *)a, b, c)
+
+/* Make these accessor calls accept the const pointers returned by OpenSSL 4.0. */
+#define X509V3_EXT_d2i(a) X509V3_EXT_d2i((X509_EXTENSION *)a)
+#define X509_NAME_get_text_by_NID(a, b, c, d) \
+    X509_NAME_get_text_by_NID((X509_NAME *)a, b, c, d)
 #endif
 
 struct k5_tls_handle_st {
@@ -162,7 +167,7 @@
 get_cert_sans(const X509 *x)
 {
     int ext;
-    X509_EXTENSION *san_ext;
+    const X509_EXTENSION *san_ext;
 
     ext = X509_get_ext_by_NID(x, NID_subject_alt_name, -1);
     if (ext < 0)
@@ -178,7 +183,7 @@
 static int
 get_cert_cn(const X509 *x, char *buf, size_t bufsize)
 {
-    X509_NAME *name;
+    const X509_NAME *name;
 
     name = X509_get_subject_name(x);
     if (name == NULL)
