From 71e610485eb51ae03c4c935177fb7685a27290be Mon Sep 17 00:00:00 2001
From: Matthew Schwartz <matthew.schwartz@linux.dev>
Date: Sun, 18 Oct 2026 17:09:44 -0700
Subject: [PATCH 053/248] [EXTERNALLY-MAINTAINED] hid-asus-ally: reconfigure
 the MCU only once on resume

ally_hid_resume() runs for every HID interface the driver binds, and the
gamepad configuration lives in the global drvdata, so on the Ally X both
the configuration and the gamepad interface attempt to reapply the same
cached configuration to the MCU on every resume.

ally_hid_reset_resume() already restricts itself to the configuration
interface. Do the same in ally_hid_resume().

Signed-off-by: Matthew Schwartz <matthew.schwartz@linux.dev>
---
 drivers/hid/hid-asus-ally.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/drivers/hid/hid-asus-ally.c b/drivers/hid/hid-asus-ally.c
index 5b40e76ef69a..657ad2cb831a 100644
--- a/drivers/hid/hid-asus-ally.c
+++ b/drivers/hid/hid-asus-ally.c
@@ -2239,9 +2239,10 @@ static void ally_hid_remove(struct hid_device *hdev)
 static int ally_hid_resume(struct hid_device *hdev)
 {
 	struct ally_gamepad_cfg *ally_cfg = drvdata.gamepad_cfg;
+	int ep = get_endpoint_address(hdev);
 	int err;
 
-	if (!ally_cfg)
+	if (!ally_cfg || ep != ROG_ALLY_CFG_INTF_IN)
 		return 0;
 
 	err = _gamepad_apply_all(hdev, ally_cfg);
-- 
