From 329fd267dca23e5dbcd5b089c0b459d846513bf1 Mon Sep 17 00:00:00 2001
From: Matthew Schwartz <matthew.schwartz@linux.dev>
Date: Wed, 23 Sep 2026 18:56:15 -0700
Subject: [PATCH 049/248] [EXTERNALLY-MAINTAINED] platform/x86: asus-wmi: pin
 fan curves across suspend on ROG XBOX Ally X

The ASUS ROG XBOX Ally X (RC73XA) EC carries its automatic fan duty
through s2idle and ramps it down slowly after resume, ignoring the fan
curve. After a warm suspend the fans come back at up to full speed with
the APU idle and take over a minute to settle. Windows sleep shows the
same thing, and rewriting the thermal policy on resume alone does not
help.

The EC holds the fans to a custom curve while one is active. On suspend,
write the factory curve for the active thermal policy to every fan,
since pinning only one freezes the other. After resume, hand control
back by rewriting the thermal policy once the EC has updated the fans.
Neither the curve write nor that update is reported, and releasing from
the resume callback brings the full-speed fans back. A 500 ms delay was
enough in testing, so hold the curve for 3 s. Skip all of this when the
user already has a custom curve enabled.

Closes: https://github.com/ValveSoftware/SteamOS/issues/2255
Closes: https://github.com/ValveSoftware/SteamOS/issues/2574
Signed-off-by: Matthew Schwartz <matthew.schwartz@linux.dev>
---
 drivers/platform/x86/asus-wmi.c | 84 +++++++++++++++++++++++++++++++++
 1 file changed, 84 insertions(+)

diff --git a/drivers/platform/x86/asus-wmi.c b/drivers/platform/x86/asus-wmi.c
index 313fa8042c7d..b58829359827 100644
--- a/drivers/platform/x86/asus-wmi.c
+++ b/drivers/platform/x86/asus-wmi.c
@@ -321,6 +321,9 @@ struct asus_wmi {
 	bool gpu_fan_curve_available;
 	bool mid_fan_curve_available;
 	struct fan_curve_data custom_fan_curves[3];
+	bool fan_curve_pin_on_suspend;
+	bool fan_curves_pinned;
+	struct delayed_work fan_curve_release_work;
 
 	struct device *ppdev;
 	bool platform_profile_support;
@@ -4093,6 +4096,63 @@ static const struct attribute_group asus_fan_curve_attr_group = {
 };
 __ATTRIBUTE_GROUPS(asus_fan_curve_attr);
 
+/* Keep the pin until the EC has run its first post-resume fan update */
+#define ASUS_FAN_CURVE_RELEASE_MS	3000
+
+static bool asus_fan_curve_any_enabled(struct asus_wmi *asus)
+{
+	struct fan_curve_data *curves = asus->custom_fan_curves;
+
+	return (asus->cpu_fan_curve_available && curves[FAN_CURVE_DEV_CPU].enabled) ||
+	       (asus->gpu_fan_curve_available && curves[FAN_CURVE_DEV_GPU].enabled) ||
+	       (asus->mid_fan_curve_available && curves[FAN_CURVE_DEV_MID].enabled);
+}
+
+/* EC resumes from a stale auto fan duty unless a custom curve is active */
+static void asus_fan_curves_suspend_pin(struct asus_wmi *asus)
+{
+	bool available[] = {
+		asus->cpu_fan_curve_available,
+		asus->gpu_fan_curve_available,
+		asus->mid_fan_curve_available,
+	};
+	struct fan_curve_data saved, *data;
+	int i, err = 0;
+
+	if (asus_fan_curve_any_enabled(asus))
+		return;
+
+	for (i = 0; i < ARRAY_SIZE(available) && !err; i++) {
+		if (!available[i])
+			continue;
+
+		/* Keep any unapplied user curve data */
+		data = &asus->custom_fan_curves[i];
+		saved = *data;
+		err = fan_curve_get_factory_default(asus, data->device_id);
+		if (!err) {
+			data->enabled = true;
+			err = fan_curve_write(asus, data);
+		}
+		*data = saved;
+	}
+
+	/* A partial pin freezes the unpinned fan, so release on failure */
+	if (err)
+		throttle_thermal_policy_write(asus);
+	asus->fan_curves_pinned = !err;
+}
+
+static void asus_fan_curves_release_work(struct work_struct *work)
+{
+	struct asus_wmi *asus = container_of(work, struct asus_wmi,
+					     fan_curve_release_work.work);
+
+	asus->fan_curves_pinned = false;
+	if (!asus_fan_curve_any_enabled(asus))
+		throttle_thermal_policy_write(asus);
+}
+
 /*
  * Must be initialised after throttle_thermal_policy_dev is set as
  * we check the status of throttle_thermal_policy_dev during init.
@@ -4132,6 +4192,12 @@ static int asus_wmi_custom_fan_curve_init(struct asus_wmi *asus)
 		&& !asus->mid_fan_curve_available)
 		return 0;
 
+	asus->fan_curve_pin_on_suspend = asus->throttle_thermal_policy_dev &&
+					 dmi_match(DMI_BOARD_NAME, "RC73XA");
+	if (asus->fan_curve_pin_on_suspend)
+		INIT_DELAYED_WORK(&asus->fan_curve_release_work,
+				  asus_fan_curves_release_work);
+
 	hwmon = devm_hwmon_device_register_with_groups(
 		dev, "asus_custom_fan_curve", asus, asus_fan_curve_attr_groups);
 
@@ -5388,6 +5454,8 @@ static void asus_wmi_remove(struct platform_device *device)
 	asus_wmi_debugfs_exit(asus);
 	asus_wmi_sysfs_exit(asus->platform_device);
 	asus_fan_set_auto(asus);
+	if (asus->fan_curve_pin_on_suspend)
+		cancel_delayed_work_sync(&asus->fan_curve_release_work);
 	throttle_thermal_policy_set_default(asus);
 	asus_wmi_battery_exit(asus);
 
@@ -5415,10 +5483,25 @@ static int asus_hotk_thaw(struct device *device)
 	return 0;
 }
 
+static int asus_hotk_suspend(struct device *device)
+{
+	struct asus_wmi *asus = dev_get_drvdata(device);
+
+	if (asus->fan_curve_pin_on_suspend) {
+		cancel_delayed_work_sync(&asus->fan_curve_release_work);
+		asus_fan_curves_suspend_pin(asus);
+	}
+	return 0;
+}
+
 static int asus_hotk_resume(struct device *device)
 {
 	struct asus_wmi *asus = dev_get_drvdata(device);
 
+	if (asus->fan_curves_pinned)
+		schedule_delayed_work(&asus->fan_curve_release_work,
+				      msecs_to_jiffies(ASUS_FAN_CURVE_RELEASE_MS));
+
 	if (!IS_ERR_OR_NULL(asus->kbd_led.dev))
 		kbd_led_update(asus);
 
@@ -5557,6 +5640,7 @@ static void asus_s2idle_check_unregister(void) {}
 static const struct dev_pm_ops asus_pm_ops = {
 	.thaw = asus_hotk_thaw,
 	.restore = asus_hotk_restore,
+	.suspend = asus_hotk_suspend,
 	.resume = asus_hotk_resume,
 	.prepare = asus_hotk_prepare,
 };
-- 
2.56.0

