From f1a15c0f6ed8df34fff0ad434f9ba35676c4e287 Mon Sep 17 00:00:00 2001
From: Alexander Egorov <begeebe@gmail.com>
Date: Tue, 28 Jul 2026 11:35:28 +0300
Subject: [PATCH 114/218] [FROM-ML] platform/x86: oxpec: Distinguish OneXPlayer
 Super X board

The Super X currently shares the oxp_g1_a board identifier because its
existing EC functionality matches the G1 AMD.

Give it a dedicated identifier so model-specific functionality can be
selected without also enabling it on the G1. Preserve the existing G1
AMD behavior for the new identifier.

Assisted-by: Codex:gpt-5.6
Signed-off-by: Alexander Egorov <begeebe@gmail.com>
---
 drivers/platform/x86/oxpec.c | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/drivers/platform/x86/oxpec.c b/drivers/platform/x86/oxpec.c
index 38c272995437..84ef04f06b36 100644
--- a/drivers/platform/x86/oxpec.c
+++ b/drivers/platform/x86/oxpec.c
@@ -51,6 +51,7 @@ enum oxp_board {
 	oxp_g1_i,
 	oxp_g1_a,
 	oxp_apex,
+	oxp_super_x,
 };
 
 static enum oxp_board board;
@@ -214,7 +215,7 @@ static const struct dmi_system_id dmi_table[] = {
 			DMI_MATCH(DMI_BOARD_VENDOR, "ONE-NETBOOK"),
 			DMI_EXACT_MATCH(DMI_BOARD_NAME, "ONEXPLAYER SUPER X"),
 		},
-		.driver_data = (void *)oxp_g1_a,
+		.driver_data = (void *)oxp_super_x,
 	},
 	{
 		.matches = {
@@ -357,6 +358,7 @@ static umode_t tt_toggle_is_visible(struct kobject *kobj,
 	case oxp_g1_i:
 	case oxp_g1_a:
 	case oxp_apex:
+	case oxp_super_x:
 		return attr->mode;
 	default:
 		break;
@@ -387,6 +389,7 @@ static ssize_t tt_toggle_store(struct device *dev,
 	case oxp_mini_amd_pro:
 	case oxp_g1_a:
 	case oxp_apex:
+	case oxp_super_x:
 		reg = OXP_TURBO_SWITCH_REG;
 		mask = OXP_TURBO_TAKE_VAL;
 		break;
@@ -434,6 +437,7 @@ static ssize_t tt_toggle_show(struct device *dev,
 	case oxp_mini_amd_pro:
 	case oxp_g1_a:
 	case oxp_apex:
+	case oxp_super_x:
 		reg = OXP_TURBO_SWITCH_REG;
 		mask = OXP_TURBO_TAKE_VAL;
 		break;
@@ -530,6 +534,7 @@ static bool oxp_psy_ext_supported(void)
 	case oxp_x1:
 	case oxp_g1_i:
 	case oxp_g1_a:
+	case oxp_super_x:
 	case oxp_fly:
 	case oxp_apex:
 		return true;
@@ -689,6 +694,7 @@ static int oxp_pwm_enable(void)
 	case oxp_g1_i:
 	case oxp_g1_a:
 	case oxp_apex:
+	case oxp_super_x:
 		return write_to_ec(OXP_SENSOR_PWM_ENABLE_REG, PWM_MODE_MANUAL);
 	default:
 		return -EINVAL;
@@ -710,6 +716,7 @@ static int oxp_pwm_disable(void)
 	case oxp_g1_i:
 	case oxp_g1_a:
 	case oxp_apex:
+	case oxp_super_x:
 		return write_to_ec(OXP_SENSOR_PWM_ENABLE_REG, PWM_MODE_AUTO);
 	default:
 		return -EINVAL;
@@ -731,6 +738,7 @@ static int oxp_pwm_read(long *val)
 	case oxp_g1_i:
 	case oxp_g1_a:
 	case oxp_apex:
+	case oxp_super_x:
 		return read_from_ec(OXP_SENSOR_PWM_ENABLE_REG, 1, val);
 	default:
 		return -EOPNOTSUPP;
@@ -768,6 +776,7 @@ static int oxp_pwm_fan_speed(long *val)
 	case oxp_mini_amd_pro:
 	case oxp_g1_a:
 	case oxp_apex:
+	case oxp_super_x:
 		return read_from_ec(OXP_SENSOR_FAN_REG, 2, val);
 	default:
 		return -EOPNOTSUPP;
@@ -801,6 +810,7 @@ static int oxp_pwm_input_write(long val)
 	case oxp_mini_amd_pro:
 	case oxp_g1_a:
 	case oxp_apex:
+	case oxp_super_x:
 		return write_to_ec(OXP_SENSOR_PWM_REG, val);
 	default:
 		return -EOPNOTSUPP;
@@ -841,6 +851,7 @@ static int oxp_pwm_input_read(long *val)
 	case oxp_mini_amd_pro:
 	case oxp_g1_a:
 	case oxp_apex:
+	case oxp_super_x:
 	default:
 		ret = read_from_ec(OXP_SENSOR_PWM_REG, 1, val);
 		if (ret)
-- 
