From df8e711c56aaa52e1c5e588a1f7ac20f9b41f8bd Mon Sep 17 00:00:00 2001
From: Alexander Egorov <begeebe@gmail.com>
Date: Tue, 28 Jul 2026 11:35:28 +0300
Subject: [PATCH 079/206] [FROM-ML] platform/x86: oxpec: Distinguish OneXPlayer
 Super X board

The Super X currently shares the oxp_g1_a board identifier because its
existing EC functionality matches the G1 AMD.

Give it a dedicated identifier so model-specific functionality can be
selected without also enabling it on the G1. Preserve the existing G1
AMD behavior for the new identifier.

Assisted-by: Codex:gpt-5.6
Signed-off-by: Alexander Egorov <begeebe@gmail.com>
---
 drivers/platform/x86/oxpec.c | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/drivers/platform/x86/oxpec.c b/drivers/platform/x86/oxpec.c
index 34bb17fca148..00a5e64b2001 100644
--- a/drivers/platform/x86/oxpec.c
+++ b/drivers/platform/x86/oxpec.c
@@ -51,6 +51,7 @@ enum oxp_board {
 	oxp_g1_i,
 	oxp_g1_a,
 	oxp_apex,
+	oxp_super_x,
 };
 
 static enum oxp_board board;
@@ -210,7 +211,7 @@ static const struct dmi_system_id dmi_table[] = {
 			DMI_MATCH(DMI_BOARD_VENDOR, "ONE-NETBOOK"),
 			DMI_EXACT_MATCH(DMI_BOARD_NAME, "ONEXPLAYER SUPER X"),
 		},
-		.driver_data = (void *)oxp_g1_a,
+		.driver_data = (void *)oxp_super_x,
 	},
 	{
 		.matches = {
@@ -357,6 +358,7 @@ static umode_t tt_toggle_is_visible(stru
 	case oxp_g1_i:
 	case oxp_g1_a:
 	case oxp_apex:
+	case oxp_super_x:
 		return attr->mode;
 	default:
 		break;
@@ -387,6 +389,7 @@ static ssize_t tt_toggle_store(struct de
 	case oxp_mini_amd_pro:
 	case oxp_g1_a:
 	case oxp_apex:
+	case oxp_super_x:
 		reg = OXP_TURBO_SWITCH_REG;
 		mask = OXP_TURBO_TAKE_VAL;
 		break;
@@ -434,6 +437,7 @@ static ssize_t tt_toggle_show(struct dev
 	case oxp_mini_amd_pro:
 	case oxp_g1_a:
 	case oxp_apex:
+	case oxp_super_x:
 		reg = OXP_TURBO_SWITCH_REG;
 		mask = OXP_TURBO_TAKE_VAL;
 		break;
@@ -523,6 +527,7 @@ static bool oxp_psy_ext_supported(void)
 	case oxp_x1:
 	case oxp_g1_i:
 	case oxp_g1_a:
+	case oxp_super_x:
 	case oxp_fly:
 		return true;
 	default:
@@ -690,6 +694,7 @@ static int oxp_pwm_enable(void)
 	case oxp_g1_i:
 	case oxp_g1_a:
 	case oxp_apex:
+	case oxp_super_x:
 		return write_to_ec(OXP_SENSOR_PWM_ENABLE_REG, PWM_MODE_MANUAL);
 	default:
 		return -EINVAL;
@@ -711,6 +716,7 @@ static int oxp_pwm_disable(void)
 	case oxp_g1_i:
 	case oxp_g1_a:
 	case oxp_apex:
+	case oxp_super_x:
 		return write_to_ec(OXP_SENSOR_PWM_ENABLE_REG, PWM_MODE_AUTO);
 	default:
 		return -EINVAL;
@@ -732,6 +738,7 @@ static int oxp_pwm_read(long *val)
 	case oxp_g1_i:
 	case oxp_g1_a:
 	case oxp_apex:
+	case oxp_super_x:
 		return read_from_ec(OXP_SENSOR_PWM_ENABLE_REG, 1, val);
 	default:
 		return -EOPNOTSUPP;
@@ -769,6 +776,7 @@ static int oxp_pwm_fan_speed(long *val)
 	case oxp_mini_amd_pro:
 	case oxp_g1_a:
 	case oxp_apex:
+	case oxp_super_x:
 		return read_from_ec(OXP_SENSOR_FAN_REG, 2, val);
 	default:
 		return -EOPNOTSUPP;
@@ -802,6 +810,7 @@ static int oxp_pwm_input_write(long val)
 	case oxp_mini_amd_pro:
 	case oxp_g1_a:
 	case oxp_apex:
+	case oxp_super_x:
 		return write_to_ec(OXP_SENSOR_PWM_REG, val);
 	default:
 		return -EOPNOTSUPP;
@@ -842,6 +851,7 @@ static int oxp_pwm_input_read(long *val)
 	case oxp_mini_amd_pro:
 	case oxp_g1_a:
 	case oxp_apex:
+	case oxp_super_x:
 	default:
 		ret = read_from_ec(OXP_SENSOR_PWM_REG, 1, val);
 		if (ret)
-- 
