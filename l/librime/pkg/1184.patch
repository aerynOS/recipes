From 96a55478ba6ae3f8e78a3c824809905745440d57 Mon Sep 17 00:00:00 2001
From: Ziheng Liu <vcliu25@gmail.com>
Date: Tue, 30 Jun 2026 02:37:59 +0800
Subject: [PATCH] fix(simplifier): handle OpenCC converters without conversion chains

OpenCC converters built from a pipeline config have no single conversion
chain, so GetConversionChain() returns null and the simplifier crashed.
Handle a missing chain (and an empty chain) as "no conversions".

Origin: upstream, https://github.com/rime/librime/pull/1184
Forwarded: https://github.com/rime/librime/pull/1184
Last-Update: 2026-11-25

---
 src/rime/gear/opencc.cc | 29 +++++++++++++++++++++++------
 1 file changed, 23 insertions(+), 6 deletions(-)

diff --git a/src/rime/gear/opencc.cc b/src/rime/gear/opencc.cc
index 86f6d60..7e65341 100644
--- a/src/rime/gear/opencc.cc
+++ b/src/rime/gear/opencc.cc
@@ -14,6 +14,20 @@
 
 namespace rime {
 
+namespace {
+
+list<opencc::ConversionPtr> GetConversions(
+    const std::shared_ptr<opencc::Converter>& converter) {
+  if (converter == nullptr)
+    return {};
+  opencc::ConversionChainPtr conversion_chain = converter->GetConversionChain();
+  if (conversion_chain == nullptr)
+    return {};
+  return conversion_chain->GetConversions();
+}
+
+}  // namespace
+
 Opencc::Opencc(const path& config_path)
     : initialized_(false), config_path_(config_path) {}
 
@@ -26,8 +40,9 @@ void Opencc::Initialize() {
     // opencc accepts file path encoded in UTF-8.
     converter_ = config.NewFromFile(config_path_.to_utf8_string());
 
-    const list<opencc::ConversionPtr> conversions =
-        converter_->GetConversionChain()->GetConversions();
+    const list<opencc::ConversionPtr> conversions = GetConversions(converter_);
+    if (conversions.empty())
+      return;
     dict_ = conversions.front()->GetDict();
   } catch (...) {
     LOG(ERROR) << "opencc config not found: " << config_path_;
@@ -39,8 +54,9 @@ bool Opencc::ConvertWord(const string& text, vector<string>* forms) {
   if (converter_ == nullptr) {
     return false;
   }
-  const list<opencc::ConversionPtr> conversions =
-      converter_->GetConversionChain()->GetConversions();
+  const list<opencc::ConversionPtr> conversions = GetConversions(converter_);
+  if (conversions.empty())
+    return false;
   vector<string> original_words{text};
   bool matched = false;
   for (auto conversion : conversions) {
@@ -103,8 +119,9 @@ bool Opencc::RandomConvertText(const string& text, string* simplified) {
   Initialize();
   if (dict_ == nullptr)
     return false;
-  const list<opencc::ConversionPtr> conversions =
-      converter_->GetConversionChain()->GetConversions();
+  const list<opencc::ConversionPtr> conversions = GetConversions(converter_);
+  if (conversions.empty())
+    return false;
   const char* phrase = text.c_str();
   for (auto conversion : conversions) {
     opencc::DictPtr dict = conversion->GetDict();
