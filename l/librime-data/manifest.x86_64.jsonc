			],
			"files": [
				"/usr/share/rime-data/essay.txt"
			],
			"name": "rime-essay"
		},
		"rime-luna-pinyin": {
			"build-depends": [
				"binary(rime_deployer)"
			],
			"depends": [
				"librime-data",
				"rime-stroke"
			],
			"files": [
				"/usr/share/rime-data/build/luna_pinyin.prism.bin",
