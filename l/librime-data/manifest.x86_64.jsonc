/** Human readable report. This is not consumed by boulder */
{
	"manifest-version": "0.2",
	"packages": {
		"librime-data": {
			"build-depends": [
				"binary(rime_deployer)"
			],
			"files": [
				"/usr/share/rime-data/build/default.yaml",
				"/usr/share/rime-data/default.yaml",
				"/usr/share/rime-data/key_bindings.yaml",
				"/usr/share/rime-data/punctuation.yaml",
				"/usr/share/rime-data/symbols.yaml"
			],
			"name": "librime-data"
		},
		"rime-bopomofo": {
			"build-depends": [
				"binary(rime_deployer)"
			],
			"depends": [
				"librime-data",
				"rime-stroke",
				"rime-terra-pinyin"
			],
			"files": [
				"/usr/share/rime-data/bopomofo.schema.yaml",
				"/usr/share/rime-data/bopomofo_express.schema.yaml",
				"/usr/share/rime-data/bopomofo_tw.schema.yaml",
				"/usr/share/rime-data/build/bopomofo.prism.bin",
				"/usr/share/rime-data/build/bopomofo.schema.yaml",
				"/usr/share/rime-data/detenele.schema.yaml",
				"/usr/share/rime-data/zhuyin.yaml"
			],
			"name": "rime-bopomofo"
		},
		"rime-cangjie": {
