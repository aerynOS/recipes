# Enable the D-Bus service (including its socket for socket activation) unconditionally
enable dbus.socket
enable dbus-broker.service

enable pipewire.socket
enable pipewire-pulse.socket
enable wireplumber.service

enable obex.service

# Enable mpris-proxy
enable mpris-proxy.service

# Ensure xdg-user-dirs are created properly
enable xdg-user-dirs.service

# Gaming related
enable dmemcg-booster-user.service
enable steamos-manager.service

# Enable the mullvad-daemon for users when it is installed
enable mullvad-daemon.service
