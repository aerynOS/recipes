From 4f5b1d305dba197bb875f18c6870e62e3960c9d2 Mon Sep 17 00:00:00 2001
From: Kyle Gospodnetich <me@kylegospodneti.ch>
Date: Tue, 4 Aug 2026 22:39:05 -0700
Subject: [PATCH 26/37] fix: Correct TDP issues on HTPCs with AMD dGPUs when
 powerstation is present (#3)

Splits the generic profile into three separate ones, ayaneo and gpd generic both getting their own. Generic is now firmly HTPC only.
Adds an option for "None" TDP since we don't want to configure TDP on HTPCs.
Modifies the load order of configs so that wildcards can't shadow real devices.
---
 data/devices/ayaneo-generic.toml | 11 +++++++++++
 data/devices/generic.toml        | 17 +----------------
 data/devices/gpd-generic.toml    | 11 +++++++++++
 steamos-manager/src/hardware.rs  | 10 ++++++++--
 steamos-manager/src/power.rs     | 24 ++++++++++++++++++++++++
 5 files changed, 55 insertions(+), 18 deletions(-)
 create mode 100644 data/devices/ayaneo-generic.toml
 create mode 100644 data/devices/gpd-generic.toml

diff --git a/data/devices/ayaneo-generic.toml b/data/devices/ayaneo-generic.toml
new file mode 100644
index 0000000..aaaedb2
--- /dev/null
+++ b/data/devices/ayaneo-generic.toml
@@ -0,0 +1,11 @@
+[[device]]
+dmi.sys_vendor = "AYANEO"
+dmi.board_name = "*"
+device = "ayaneo_generic"
+variant = "AYANEO_Generic"
+
+[tdp_limit]
+method = "power_station"
+
+[inputplumber]
+target_devices = ["deck-uhid", "keyboard", "mouse"]
\ No newline at end of file
diff --git a/data/devices/generic.toml b/data/devices/generic.toml
index 6c34358..3874117 100644
