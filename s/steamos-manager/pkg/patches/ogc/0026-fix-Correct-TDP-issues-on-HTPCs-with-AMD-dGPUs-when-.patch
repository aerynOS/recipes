-dmi.board_name = "*"
-device = "gpd_generic"
-variant = "GPD_Generic"
-
-[[device]]
-dmi.sys_vendor = "AYANEO"
-dmi.board_name = "*"
-device = "ayaneo_generic"
-variant = "AYANEO_Generic"
-
 [[device]]
 dmi.sys_vendor = "*"
 dmi.board_name = "*"
@@ -17,7 +5,4 @@ device = "generic"
 variant = "Generic"
 
 [tdp_limit]
-method = "power_station"
-
-[inputplumber]
-target_devices = ["deck-uhid", "keyboard", "mouse"]
