Preserve cross-document YAML aliases with go-yaml v4.

go-yaml v4 keeps anchors inside one document unless the alias-data plugin
is configured with stream scope. yq 4.54.2 already requires v4.0.0-rc.7,
but it still decodes with NewDecoder, so an alias such as *remember fails
when the anchor was defined in an earlier document.

Load each input with a fresh stream-scoped loader. This follows
https://github.com/mikefarah/yq/pull/2956; that pull request's module bump
is already present in this release. A bare colon is valid YAML here, so
the invalid-snippet fixture is an unterminated sequence. goccy/go-json
v0.12 reports the same syntax error as encoding/json, so the bad-JSON
expectation matches that message.

---
diff --git a/pkg/yqlib/decoder_yaml.go b/pkg/yqlib/decoder_yaml.go
index 49be6c6..91d22fb 100644
--- a/pkg/yqlib/decoder_yaml.go
+++ b/pkg/yqlib/decoder_yaml.go
@@ -9,6 +9,7 @@ import (
 	"strings"
 
 	yaml "go.yaml.in/yaml/v4"
+	"go.yaml.in/yaml/v4/plugin/aliasdata"
 )
 
 var (
@@ -19,7 +20,7 @@ var (
 )
 
 type yamlDecoder struct {
-	decoder yaml.Decoder
+	decoder *yaml.Loader
 
 	prefs YamlPreferences
 
@@ -137,7 +138,14 @@ func (dec *yamlDecoder) Init(reader io.Reader) error {
 	}
 	dec.leadingContent = leadingContent
 	dec.readAnything = false
-	dec.decoder = *yaml.NewDecoder(readerToUse)
+	aliasData, err := aliasdata.New(aliasdata.WithStream(true))
+	if err != nil {
+		return err
+	}
+	dec.decoder, err = yaml.NewLoader(readerToUse, yaml.WithPlugin(aliasData))
+	if err != nil {
+		return err
+	}
 	dec.firstFile = false
 	dec.documentIndex = 0
 	dec.anchorMap = make(map[string]*CandidateNode)
@@ -146,7 +154,7 @@ func (dec *yamlDecoder) Init(reader io.Reader) error {
 
 func (dec *yamlDecoder) Decode() (*CandidateNode, error) {
 	var yamlNode yaml.Node
-	err := dec.decoder.Decode(&yamlNode)
+	err := dec.decoder.Load(&yamlNode)
 
 	if errors.Is(err, io.EOF) && dec.leadingContent != "" && !dec.readAnything {
 		// force returning an empty node with a comment.
