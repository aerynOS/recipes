From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Reilly Brogan <reilly@reillybrogan.com>
Date: Thu, 12 Dec 2024 19:13:16 -0600
Subject: [PATCH] Set default settings for compression and build-id

Set the default to compress debug sections with zstd, and also set the default to create a build-id using BLAKE3 that's 160 bits long.

Origin: vendor
Forwarded: not-needed
Last-Update: 2026-10-06
---
 src/cmdline.rs | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/cmdline.rs b/src/cmdline.rs
index ebfd5cf..f546401 100644
--- a/src/cmdline.rs
+++ b/src/cmdline.rs
@@ -562,7 +562,7 @@ impl Default for Args {
     fn default() -> Self {
         Self {
             bsymbolic: BsymbolicKind::None,
-            build_id: BuildId::default(),
+            build_id: BuildId::Hash(20),
             z_cet_report: CetReportKind::None,
             undefined_glob: Glob::new(),
             unique: Glob::new(),
@@ -642,7 +642,7 @@ impl Default for Args {
             z_start_stop_visibility_protected: false,
             z_text: false,
             zero_to_bss: false,
-            compress_debug_sections: DebugCompression::None,
+            compress_debug_sections: DebugCompression::Zstd(3),
             filler: None,
             spare_dynamic_tags: 5,
             spare_program_headers: 0,
