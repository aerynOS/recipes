From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Reilly Brogan <reilly@reillybrogan.com>
Date: Thu, 24 Sep 2026 12:51:22 -0500
Subject: [PATCH] stateless

Install the default mango configuration to %(datadir)/defaults/mango instead of
/etc/mango, and teach the config loader to fall back to that location.

This keeps the shipped defaults in /usr (stateless) so they are owned by the
package and are not treated as administrator-editable state. Users can still
override them in ~/.config/mango, and administrators in /etc/mango, both of
which continue to take precedence over the vendor defaults.

Origin: vendor
Forwarded: not-needed
Last-Update: 2026-10-09
---
 meson.build               |  4 ++--
 src/config/load.c         | 12 ++++++++++++
 2 files changed, 14 insertions(+), 2 deletions(-)

--- a/meson.build
+++ b/meson.build
@@ -235,8 +235,8 @@
 portal_install_dir = join_paths(prefix, 'share/xdg-desktop-portal')
 install_data('assets/mango.desktop', install_dir : desktop_install_dir)
 install_data('assets/mango-portals.conf', install_dir : portal_install_dir)
-install_data('assets/config.conf', install_dir : join_paths(sysconfdir, 'mango'))
-install_data('assets/config.toml', install_dir : join_paths(sysconfdir, 'mango'))
+install_data('assets/config.conf', install_dir : join_paths('/usr/share/defaults', 'mango'))
+install_data('assets/config.toml', install_dir : join_paths('/usr/share/defaults', 'mango'))
 
 # Ship mango-session.target so that systemd user services declaring
 # WantedBy=graphical-session.target (portals, panels, ...) are started together
--- a/src/config/load.c
+++ b/src/config/load.c
@@ -47,6 +47,10 @@
 #define SYSCONFDIR "/etc"
 #endif
 
+#ifndef VENDORDIR
+#define VENDORDIR "/usr/share/defaults"
+#endif
+
 Config config;
 
 const char default_jump_labels[] = "HJKLASDFGQWERTYUIOPZXCVBNM";
@@ -402,6 +406,14 @@
 				snprintf(filename, sizeof(filename), "%s/mango/config.toml",
 						 SYSCONFDIR);
 			}
+			if (access(filename, F_OK) != 0) {
+				snprintf(filename, sizeof(filename), "%s/mango/config.conf",
+						 VENDORDIR);
+			}
+			if (access(filename, F_OK) != 0) {
+				snprintf(filename, sizeof(filename), "%s/mango/config.toml",
+						 VENDORDIR);
+			}
 		}
 	}
 
