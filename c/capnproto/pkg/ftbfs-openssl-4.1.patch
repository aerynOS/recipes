From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Reilly Brogan <reilly@reillybrogan.com>
Date: Fri, 6 Nov 2026 12:00:00 -0600
Subject: [PATCH] test: Add subjectAltName to the TLS test certificates

OpenSSL 4.1 no longer consults the subject commonName when verifying a peer's
host name unless X509_CHECK_FLAG_ALWAYS_CHECK_SUBJECT is set, so every TLS test
fails with "TLS peer's certificate is not trusted; reason = hostname mismatch".

Reissue the test certificates with a subjectAltName, and make
make-test-certs.sh use a self-contained CA configuration since the system
openssl.cnf need not provide a usable CA_default section.

Origin: vendor
Forwarded: not-needed
Last-Update: 2026-11-06
---
 c++/src/kj/compat/make-test-certs.sh | 62 +++++-----
 c++/src/kj/compat/tls-test.c++       | 574 ++++++++++++++++++++++++++++++--------------------
 2 files changed, 347 insertions(+), 289 deletions(-)

--- a/c++/src/kj/compat/make-test-certs.sh
+++ b/c++/src/kj/compat/make-test-certs.sh
@@ -30,6 +30,39 @@
 # Clean up from previous runs.
 rm -rf demoCA *.key *.csr *.crt
 
+# Self-contained CA configuration; the system openssl.cnf may not have a
+# CA_default section pointing at ./demoCA.
+cat > ca.cnf << EOF
+[ ca ]
+default_ca = CA_default
+
+[ CA_default ]
+dir             = ./demoCA
+database        = \$dir/index.txt
+new_certs_dir   = \$dir/newcerts
+certificate     = \$dir/cacert.pem
+private_key     = \$dir/private/cakey.pem
+serial          = \$dir/serial
+default_md      = sha256
+policy          = policy_any
+email_in_dn     = yes
+unique_subject  = no
+
+[ policy_any ]
+countryName            = optional
+stateOrProvinceName    = optional
+localityName           = optional
+organizationName       = optional
+organizationalUnitName = optional
+commonName             = supplied
+emailAddress           = optional
+
+[ v3_ca ]
+subjectKeyIdentifier = hash
+authorityKeyIdentifier = keyid:always,issuer
+basicConstraints = critical, CA:true
+EOF
+
 # Function to fake out OpenSSL CA configuration. Pass base name of files as parameter.
 setup_ca_dir() {
   rm -rf demoCA
@@ -70,7 +103,7 @@
 
 # Sign the intermediate cert with the CA key.
 setup_ca_dir ca
-openssl ca -extensions v3_ca -days 36500 -notext -md sha256 -in int.csr -out int.crt << EOF
+openssl ca -config ca.cnf -extensions v3_ca -days 36500 -notext -md sha256 -in int.csr -out int.crt << EOF
 y
 y
 EOF
@@ -91,16 +124,26 @@
 EOF
 echo
 
+# Host certificates need a subjectAltName: OpenSSL 4.1 no longer falls back to
+# the subject commonName when verifying a peer's host name.
+cat > host.ext << EOF
+[ v3_ca ]
+subjectKeyIdentifier = hash
+authorityKeyIdentifier = keyid:always,issuer
+basicConstraints = critical, CA:true
+subjectAltName = DNS:example.com
+EOF
+
 # Sign valid host certificate with intermediate CA.
 setup_ca_dir int
-openssl ca -extensions v3_ca -days 36524 -notext -md sha256 -in example.csr -out valid.crt << EOF
+openssl ca -config ca.cnf -extfile host.ext -extensions v3_ca -days 36524 -notext -md sha256 -in example.csr -out valid.crt << EOF
 y
 y
 EOF
 
 # Sign expired host certificate with intermediate CA.
 setup_ca_dir int
-openssl ca -extensions v3_ca -startdate 160101000000Z -enddate 160101000000Z -notext -md sha256 -in example.csr -out expired.crt << EOF
+openssl ca -config ca.cnf -extfile host.ext -extensions v3_ca -startdate 160101000000Z -enddate 160101000000Z -notext -md sha256 -in example.csr -out expired.crt << EOF
 y
 y
 EOF
@@ -120,15 +163,24 @@
 EOF
 echo
 
+cat > host2.ext << EOF
+[ v3_ca ]
+subjectKeyIdentifier = hash
+authorityKeyIdentifier = keyid:always,issuer
+basicConstraints = critical, CA:true
+subjectAltName = DNS:example.net
+EOF
+
 # Sign valid host certificate with intermediate CA.
 setup_ca_dir int
-openssl ca -extensions v3_ca -days 36524 -notext -md sha256 -in example2.csr -out valid2.crt << EOF
+openssl ca -config ca.cnf -extfile host2.ext -extensions v3_ca -days 36524 -notext -md sha256 -in example2.csr -out valid2.crt << EOF
 y
 y
 EOF
 
 # Create self-signed host certificate.
-openssl req -key example.key -new -x509 -days 36524 -sha256 -out self.crt << EOF
+openssl req -key example.key -new -x509 -days 36524 -sha256 \
+  -addext "subjectAltName = DNS:example.com" -out self.crt << EOF
 US
 California
 Palo Alto
