From 04f9f93e7f2690981df36604e4e1385d316aa0ff Mon Sep 17 00:00:00 2001
From: David Wales <daviewales@disroot.org>
Date: Sat, 14 Nov 2026 04:51:45 +1100
Subject: [PATCH] Fall back to nanorc in stateless directory

---
 src/rcfile.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/rcfile.c b/src/rcfile.c
index cd155dd..16f7a2c 100644
--- a/src/rcfile.c
+++ b/src/rcfile.c
@@ -1726,7 +1726,8 @@ void do_rcfiles(void)
 	} else {
 		const char *xdgconfdir;
 
-		if (have_nanorc(SYSCONFDIR, "/nanorc"))
+		if (have_nanorc(SYSCONFDIR, "/nanorc") ||
+				have_nanorc("/usr/share/defaults/nano", "/nanorc"))
 			parse_one_nanorc();
 
 		get_homedir();
